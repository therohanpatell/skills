{
  "server": {
    "host": "127.0.0.1",
    "port": 8300
  },
  "paths": {
    "ytdlp": "yt-dlp",
    "ffmpeg": "ffmpeg",
    "mpv": "mpv",
    "python": "python",
    "dataDir": "data",
    "logDir": "logs"
  },
  "limits": {
    "maxSources": 20
  },
  "vcam": {
    "enabled": true,
    "device": "OBS Virtual Camera",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "pixelFormat": "nv12"
  },
  "preview": {
    "width": 480,
    "fps": 10,
    "quality": 8
  },
  "monitor": {
    "enabled": true,
    "audioDevice": "auto",
    "hwdec": "auto-safe",
    "mode": "video-audio"
  },
  "audioLoopback": {
    "enabled": false,
    "device": "auto"
  },
  "ffmpeg": {
    "hwaccel": "d3d11va",
    "hwaccelFallback": true
  },
  "resolve": {
    "timeoutMs": 45000,
    "liveRefreshMs": 10800000,
    "vodRefreshMs": 18000000,
    "maxVideoHeight": 1080,
    "maxLiveHeight": 1080,
    "degradedLiveHeight": 480
  },
  "stats": {
    "intervalMs": 1000
  },
  "supervisor": {
    "restartBaseDelayMs": 1000,
    "restartMaxDelayMs": 30000,
    "circuitBreakerFailures": 6,
    "circuitBreakerWindowMs": 120000
  }
}
