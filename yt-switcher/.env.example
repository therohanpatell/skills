# Copy to .env and adjust. Every value here overrides config/default.json.

# Server
YTSW_HOST=127.0.0.1
YTSW_PORT=8300

# Absolute paths to binaries if they are not on PATH.
# IMPORTANT: the server must be RESTARTED after changing this file.
# Example: YTSW_MPV_PATH=C:\Tools\mpv\mpv.exe
# (Common locations like C:\Tools\<tool>, Program Files, winget/scoop/choco
#  dirs are auto-detected if the configured name isn't found.)
YTSW_YTDLP_PATH=yt-dlp
YTSW_FFMPEG_PATH=ffmpeg
YTSW_MPV_PATH=mpv
YTSW_PYTHON_PATH=python
# akvirtualcamera manager (powers the branded "YT Switcher Virtual Cam")
YTSW_AKVCAM_PATH=AkVCamManager

# Virtual camera output format
YTSW_VCAM_ENABLED=true
YTSW_VCAM_WIDTH=1280
YTSW_VCAM_HEIGHT=720
YTSW_VCAM_FPS=30

# mpv program monitor window (full-quality preview + audio)
YTSW_MONITOR_ENABLED=true

# FFmpeg hardware decode (d3d11va | cuda | qsv | auto | none)
YTSW_FFMPEG_HWACCEL=d3d11va

# Logging: trace | debug | info | warn | error
YTSW_LOG_LEVEL=info
