# Copy to .env and adjust. Every setting is also a PDFOCR_* environment variable.

# --- server ---
PDFOCR_HOST=0.0.0.0
PDFOCR_PORT=8000
# Set to require an X-API-Key header. Leave empty for an open service on a trusted LAN.
PDFOCR_API_KEY=

# --- OCR ---
# auto | vlm | native | tesseract
PDFOCR_ENGINE=auto
PDFOCR_DPI=200
PDFOCR_PAGE_CONCURRENCY=2
PDFOCR_JOB_CONCURRENCY=2
PDFOCR_MAX_PAGES=0
PDFOCR_MAX_UPLOAD_MB=200

# --- vision model (any OpenAI-compatible server) ---
# Ollama:    http://localhost:11434/v1   with qwen2.5vl:7b
# vLLM:      http://localhost:8001/v1    with deepseek-ai/DeepSeek-OCR
# LM Studio: http://localhost:1234/v1
PDFOCR_VLM_BASE_URL=http://localhost:11434/v1
PDFOCR_VLM_MODEL=qwen2.5vl:7b
PDFOCR_VLM_API_KEY=not-needed
PDFOCR_VLM_TIMEOUT=300
PDFOCR_VLM_MAX_TOKENS=4096

# --- tesseract fallback ---
PDFOCR_TESSERACT_LANG=eng

# --- storage ---
PDFOCR_STORAGE_DIR=storage
PDFOCR_JOB_TTL_SECONDS=86400
